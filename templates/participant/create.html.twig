{% extends 'base.html.twig' %}

{% block title %}
    Sortir-ENI | Créer un compte
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
        </div>
    {% endfor %}

    <h1 class="text-center mt-2 mb-5"> Création de compte </h1>

    <form action="{{ path('participant_upload_csv') }}" method="post" enctype="multipart/form-data">
        <div class="container mb-4">
            <div class="form-group mb-3">
                <div class="custom-file mb-3">
                    <div class="text-center mb-2">
                        <label for="csv_file" class="form-label mb-4" style="font-size: 1.3rem;">Téléchargez votre fichier CSV</label>
                    </div>
                    <input type="file" name="csv_file" id="csv_file" class="custom-file-input form-control" accept=".csv">
                    <button type="submit" class="btn btn-primary mt-3">Importer</button>
                </div>
            </div>
        </div>
    </form>

    <div class="text-center my-4">
        <span class="or-divider">----------- ou -----------</span>
    </div>

    {{ form_start(participantForm) }}
        <div class="container mb-5 mt-4">
            <div class="form-label text-center mb-3" style="font-size: 1.3rem;">Créez manuellement un compte</div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.Lastname) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.Firstname) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.telephone) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.email) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.newPassword, {'label': 'Mot de passe (si vide, le mot de passe par défaut sera appliqué)'}) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.campus, {'label': 'Campus <span class="red-text">*</span>', 'label_html': true}) }}
            </div>
            <div class="form-group mb-3">
                {{ form_row(participantForm.roles) }}
            </div>
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Créer</button>
                <a href="{{ path('main_accueil') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </div>
    {{ form_end(participantForm) }}
{% endblock %}
