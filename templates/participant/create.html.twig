{% extends 'base.html.twig' %}

{% block title %}
    Créer un compte
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
        </div>
    {% endfor %}

    <h1 style="text-align: center"> Création de compte </h1>
    {{ form_start(participantForm) }}
    {{ form_row(participantForm.Lastname) }}
    {{ form_row(participantForm.Firstname) }}
    {{ form_row(participantForm.telephone) }}
    {{ form_row(participantForm.email) }}
    {{ form_row(participantForm.newPassword, {'label' : 'Mot de passe (si vide, le mot de passe par défaut sera appliqué)'}) }}
    {{ form_row(participantForm.campus) }}
    {{ form_row(participantForm.roles) }}
    <button type="submit" class="btn btn-primary">Créer</button>
    <a href="{{ path('main_accueil') }}"><button type="button" class="btn btn-primary">Annuler</button></a>
    {{ form_end(participantForm) }}
{% endblock %}
