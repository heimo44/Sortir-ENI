{% extends 'base.html.twig' %}

{% block title %}
    {% if participant.pseudo is null %}
        {{ participant.Lastname }} | Affichage
    {% else %}
        {{ participant.pseudo }} | Affichage
    {% endif %}
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
        </div>
    {% endfor %}

    <div class="text-center mb-4">
        <h1>
            {% set displayName = participant.pseudo is not null ? participant.pseudo : participant.Firstname ~ ' ' ~ participant.Lastname %}
            {{ displayName }}

            {% if app.user.roles[0] == 'ROLE_ADMIN' %}
                <span class="{{ participant.isActif ? 'actif-color' : 'inactif-color' }}">
            [ {{ participant.isActif ? 'Actif' : 'Inactif' }} ]
        </span>
            {% endif %}
        </h1>
    </div>

    <div class="d-flex justify-content-left">
        <div class="profile-content">
            <div class="photo-profile">
                {% if participant.profileImageFilename is not empty %}
                    <img src="{{ asset('uploads/images/' ~ participant.profileImageFilename) }}"
                         alt="Profile Image"
                         style="width: 150px; height: 150px; object-fit: cover;">
                {% endif %}
            </div>
            <div class="container-user">
                <table class="table-profile">
                    <tbody>
                    <tr>
                        <td class="text-end" style="width: 50%;">Prénom :</td>
                        <td style="width: 50%;">{{ participant.Firstname }}</td>
                    </tr>
                    <tr>
                        <td class="text-end" style="width: 50%;">Nom :</td>
                        <td style="width: 50%;">{{ participant.Lastname }}</td>
                    </tr>
                    <tr>
                        <td class="text-end" style="width: 50%;">Téléphone :</td>
                        <td style="width: 50%;">{{ participant.telephone }}</td>
                    </tr>
                    <tr>
                        <td class="text-end" style="width: 50%;">Email :</td>
                        <td style="width: 50%;">{{ participant.email }}</td>
                    </tr>
                    <tr>
                        <td class="text-end" style="width: 50%;">Campus :</td>
                        <td style="width: 50%;">
                            {% if participant.campus is null %}
                                Pas de campus
                            {% else %}
                                {{ participant.campus.nom }}
                            {% endif %}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if app.user and (app.user.id == participant.id) %}
        <div class="text-center">
            <a href="{{ path('participant_edit', {'id': app.user.id}) }}">
                <button type="button" class="btn btn-primary">Éditer mon profil</button>
            </a>
        </div>
    {% endif %}

    {% if app.user.roles[0] == 'ROLE_ADMIN' and app.user.id != participant.id and participant.roles[0] != 'ROLE_ADMIN'  %}
        <div class="mt-3 text-center">
            <form action="{{ path('participant_show', { 'id': participant.id }) }}" method="POST">
                <input type="hidden" name="actif" value="{{ participant.isActif ? '0' : '1' }}">
                <button type="submit" class="btn {{ participant.isActif ? 'btn-danger' : 'btn-success' }}">
                    {{ participant.isActif ? 'Désactiver' : 'Activer' }}
                </button>
            </form>
        </div>
    {% endif %}

{% endblock %}