{% extends 'base.html.twig' %}

{% block title %}
    {% if participant.pseudo is null %}
        {{ participant.Lastname }} | Edition
    {% else %}
        {{ participant.pseudo }} | Edition
    {% endif %}
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                {{ message }}
            {% endfor %}
        </div>
    {% endfor %}

    <h1 style="text-align: center"> Éditer mon profil </h1>
    {{ form_start(participantForm) }}
{#    {{ form_row(participantForm.profileImage) }}#}
    {{ form_row(participantForm.pseudo) }}
    {{ form_row(participantForm.Lastname) }}
    {{ form_row(participantForm.Firstname) }}
    {{ form_row(participantForm.telephone) }}
    {{ form_row(participantForm.email) }}
    {{ form_row(participantForm.newPassword) }}
    {{ form_row(participantForm.newPasswordConfirmation) }}
    {{ form_row(participantForm.campus) }}
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a href="{{ path('participant_show', {'id': app.user.id}) }}"><button type="button" class="btn btn-primary">Annuler</button></a>
    {{ form_end(participantForm) }}
{% endblock %}