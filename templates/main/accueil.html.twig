{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} | Faites des sorties !
{% endblock %}

{% block body %}
    <div class="d-flex flex-column float-end pe-2 fw-bold" >
        <div class="d-none d-md-table-cell">
            Date du jour : {{ currentDate|date('d/m/Y') }}
        </div>
        {% if user %}
        <div class="d-none d-md-table-cell">
            Participant : {{ user.Lastname }} {{ user.Firstname }}
        </div>
        {% endif %}
    </div>
    <div class="mt-5">
        <h5 class="d-none d-md-table-cell">Filtrer les sorties</h5>
        <h3 class="d-table-cell d-md-none">Mes Sorties</h3>
    </div>

    {{ form_start(accueilForm) }}
    <div>
        <div class="d-flex justify-content-around">
            <div class="column-1 d-none d-md-block">
                <!-- Label et input pour le campus côte à côte -->
                <div class="d-flex align-items-center mb-1">
                    {{ form_label(accueilForm.campus, 'Campus', {'label_attr': {'class': 'me-5'}}) }} <!-- Le label Campus -->
                    {{ form_widget(accueilForm.campus, {'attr': {'class': 'form-control', 'style': 'height: 30px; font-size: 0.8rem;'}}) }} <!-- Input campus -->
                </div>

                <!-- Label et input pour la recherche côte à côte -->
                <div class="d-flex align-items-center mb-1">
                    {{ form_label(accueilForm.nom_sortie, 'Rechercher', {'label_attr': {'class': 'me-5'}}) }} <!-- Le label Rechercher -->
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i> <!-- Icône de loupe -->
                        </span>
                        {{ form_widget(accueilForm.nom_sortie, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher une sortie...', 'style': 'height: 30px; font-size: 0.8rem;'}}) }} <!-- Input de recherche -->
                    </div>
                </div>

                <div class="d-flex align-items-center mb-1">
                    <label class="me-2">{{ form_label(accueilForm.date_debut, 'Entre') }}</label>
                    {{ form_widget(accueilForm.date_debut, { 'attr': {'class': 'form-control me-2', 'style': 'height: 30px; font-size: 0.8rem;'} }) }}

                    <label class="me-2">{{ form_label(accueilForm.date_fin, 'et') }}</label>
                    {{ form_widget(accueilForm.date_fin, { 'attr': {'class': 'form-control me-5', 'style': 'height: 30px; font-size: 0.8rem;'} }) }}
                </div>
        </div>

        <div class="column-2 d-none d-md-block">
            <div>
                {{ form_label(accueilForm.organisateur) }}
                {{ form_widget(accueilForm.organisateur) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_inscrit , { 'attr': {'class': 'form-control' }}) }}
                {{ form_widget(accueilForm.sortie_inscrit) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_non_inscrit, { 'attr': {'class': 'form-control' }}) }}
                {{ form_widget(accueilForm.sortie_non_inscrit) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_passee , { 'attr': {'class': 'form-control' }}) }}
                {{ form_widget(accueilForm.sortie_passee) }}
            </div>
        </div>

        <div class="d-flex align-items-center column-3 d-none d-md-block">
            {{ form_widget(accueilForm.rechercher, {'attr': {'class': 'btn btn-primary p-4 '}}) }}
        </div>

    </div>
</div>
{{ form_end(accueilForm) }}

    <div class="mt-5">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Nom de la sortie</th>
                <th>Date de la sortie</th>
                <th class="d-none d-md-table-cell">Clôture</th>
                <th class="d-none d-md-table-cell" >Inscrits/Places</th>
                <th class="d-none d-md-table-cell">État</th>
                <th class="d-none d-md-table-cell">Inscrits</th>
                <th class="d-none d-md-table-cell">Organisateur</th>
                <th class="d-none d-md-table-cell">Actions</th>
                <th class="d-table-cell d-md-none">Lieu</th>
            </tr>
            </thead>
            <tbody>
            {% for sortie in sorties %}
                <tr>
                    <td>{{ sortie.nom }}</td>
                    <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                    <td class="d-none d-md-table-cell">{{ sortie.dateLimiteInscription|date('d/m/Y') }}</td>
                    <td class="d-none d-md-table-cell">{{ sortie.participants|length }} / {{ sortie.nbInscriptionsMax }}</td>
                    <td class="d-none d-md-table-cell">{{ sortie.etat.libelle }}</td>
                    <td class="d-table-cell d-md-none">{{ sortie.lieu.ville.nom}}</td>
                    <td>
{#                        {% for participant in sortie.participants %}#}
{#                            {{ participant.firstname }} {{ participant.lastname }}<br>#}
{#                        {% else %}#}
{#                            Aucun inscrit#}
{#                        {% endfor %}#}
                        {% if sortie.participants.contains(app.user) %}
                            ✖️
                        {% endif %}
                    </td>
                    <td class="d-none d-md-table-cell"><a href="{{ path('participant_show', {'id': sortie.organisateur.id}) }}">{{ sortie.organisateur.Firstname }} {{ sortie.organisateur.Lastname }}</a></td>
                    <td>
                        {% if sortie.etat.libelle == 'Passée' %}
                            Sortie passée
                        {% elseif sortie.etat.libelle == 'Créée' and sortie.organisateur.id == user.id %}
                            <a class="btn btn-primary" href="{{ path('app_sortie_publish', {'id': sortie.id}) }}">Publier</a>
                            <a class="btn btn-secondary" href="{{ path('app_sortie_edit', {'id': sortie.id}) }}">Modifier</a>
                        {% elseif sortie.etat.libelle == 'Ouverte' or sortie.etat.libelle == 'Créée' or sortie.etat.libelle == 'Activité en cours' or sortie.etat.libelle == 'Clôturée'%}
                            {% if sortie.etat.libelle == 'Ouverte' and sortie.organisateur.id != user.id %}
                                {% if sortie.participants.contains(app.user) %}
                                    <a class="btn btn-danger" href="{{ path('app_sortie_remove_participant', {'id': sortie.id}) }}">Désister</a>
                                {% else %}
                                    <a class="btn btn-primary" href="{{ path('app_sortie_add_participant', {'id': sortie.id}) }}">Inscrire</a>
                                {% endif %}
                            {% endif %}
                            <a class="btn btn-secondary" href="{{ path('app_sortie_show', {'id': sortie.id}) }}">Afficher</a>
                            {% if sortie.etat.libelle == 'Ouverte' and  sortie.organisateur.id == user.id %}
                                <a class="btn btn-danger" href="{{ path('app_sortie_cancel', {'id': sortie.id}) }}">Annuler</a>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucune sortie trouvée pour ces critères.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="column-2 d-none d-md-block">
    <button class="btn btn-primary p-2"><a href="{{ path('app_sortie_new') }}" class="text-decoration-none text-white">Créer une sortie</a></button>
    <div class="column-2 d-none d-md-block">
{% endblock %}