{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} | Faites des sorties !
{% endblock %}

{% block body %}
    <div class="d-flex flex-column float-end pe-2 fw-bold" >
        <div>
            Date du jour : {{ currentDate|date('d/m/Y') }}
        </div>
        {% if user %}
        <div>
            Participant : {{ user.Lastname }} {{ user.Firstname }}
        </div>
        {% endif %}
    </div>
    <div class="mt-5">
        <h5>Filtrer les sorties</h5>
    </div>

    {{ form_start(accueilForm) }}
    <div>
        <div class="d-flex justify-content-around">
            <div class="column-1">
                <!-- Label et input pour le campus côte à côte -->
                <div class="d-flex align-items-center mb-1">
                    {{ form_label(accueilForm.campus, 'Campus', {'label_attr': {'class': 'me-5'}}) }} <!-- Le label Campus -->
                    {{ form_widget(accueilForm.campus, {'attr': {'class': 'form-control', 'style': 'height: 30px; font-size: 0.8rem;'}}) }} <!-- Input campus -->
                </div>

                <!-- Label et input pour la recherche côte à côte -->
                <div class="d-flex align-items-center mb-1">
                    {{ form_label(accueilForm.nom_sortie, 'Rechercher', {'label_attr': {'class': 'me-5'}}) }} <!-- Le label Rechercher -->
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i> <!-- Icône de loupe -->
                        </span>
                        {{ form_widget(accueilForm.nom_sortie) }} <!-- Input de recherche -->
                    </div>
                </div>

                <div class="d-flex align-items-center mb-1">
                    <label class="me-2">{{ form_label(accueilForm.date_debut, 'Entre') }}</label>
                    {{ form_widget(accueilForm.date_debut) }}

                    <label class="me-2">{{ form_label(accueilForm.date_fin, 'et') }}</label>
                    {{ form_widget(accueilForm.date_fin) }}
                </div>
        </div>

        <div class="column-2">
            <div>
                {{ form_label(accueilForm.organisateur, "Sorties dont je suis l\'organisateur//trice") }}
                {{ form_widget(accueilForm.organisateur) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_inscrit, "Sories auxquelles je suis inscrit//e",{ "attr": {"class": "form-control" }}) }}
                {{ form_widget(accueilForm.sortie_inscrit) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_non_inscrit, "Sorties auxquelles je ne suis pas inscrit//e", { "attr": {"class": "form-control" }}) }}
                {{ form_widget(accueilForm.sortie_non_inscrit) }}
            </div>

            <div>
                {{ form_label(accueilForm.sortie_passee , "Sorties passées", { "attr": {"class": "form-control" }}) }}
                {{ form_widget(accueilForm.sortie_passee) }}
            </div>
        </div>

        <div class="d-flex align-items-center column-3">
            {{ form_widget(accueilForm.rechercher, {"attr": {"class": "btn btn-primary p-4"}}) }}
        </div>

    </div>
</div>
{{ form_end(accueilForm) }}

<div class="mt-2">
    <h4>Sorties</h4>
    <div class="table-container">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Nom de la sortie</th>
                <th>Date de la sortie</th>
                <th>Clôture</th>
                <th>État</th>
                <th>Organisateur</th>
            </tr>
            </thead>
            <tbody>
                {% for sortie in sorties %}
                    <tr>
                        <td>{{ sortie.nom }}</td>
                        <td>{{ sortie.dateHeureDebut|date("d/m/Y H:i") }}</td>
                        <td>{{ sortie.dateLimiteInscription|date("d/m/Y") }}</td>
                        <td>{{ sortie.etat.libelle }}</td>
                        <td>{{ sortie.organisateur.Lastname }} {{ sortie.organisateur.Firstname }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Aucune sortie trouvée pour ces critères.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a href="{{ path("app_sortie_new") }}" class="btn btn-primary p-2 text-white text-decoration-none">Créer une sortie</a>
</div>

{% endblock %}